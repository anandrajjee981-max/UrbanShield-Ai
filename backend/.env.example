# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL connection string (do not commit real credentials)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# ImageKit (issue photos). Both keys are server side only: they are never sent
# to the browser. IMAGEKIT_PUBLIC_KEY is not used for uploads, it is validated
# at boot so a half filled .env fails fast.
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Maximum size of one issue photo in bytes (default 5 MB).
ISSUE_IMAGE_MAX_BYTES=5242880
# How many issues one citizen may report per minute (anti spam).
ISSUE_RATE_LIMIT_PER_MINUTE=60
# How many issue photos one citizen may upload per minute (anti spam).
ISSUE_UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Frontend origin allowed by CORS (comma separated for several origins).
# Required for cookies: the browser only sends the access_token cookie when
# CORS is configured with an explicit origin and credentials: true.
FRONTEND_URL=http://localhost:5173

# OpenWeatherMap (3-day weather feature, GET /api/weather). Server side only:
# the key is never sent to the browser. Get one free at
# https://openweathermap.org/api and paste it here. Optional: without it the
# app still boots, but /api/weather answers 503 WEATHER_NOT_CONFIGURED.
OPENWEATHER_API_KEY=replace_with_your_openweathermap_key
# How many weather lookups one IP may make per minute (default 30).
WEATHER_RATE_LIMIT_PER_MINUTE=30
