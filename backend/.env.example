# Server
PORT=4000
NODE_ENV=development

# Neon PostgreSQL connection string (do not commit real credentials)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Authentication
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# ImageKit (issue photos). Both keys are server side only: they are never sent
# to the browser. IMAGEKIT_PUBLIC_KEY is not used for uploads, it is validated
# at boot so a half filled .env fails fast.
IMAGEKIT_PUBLIC_KEY=public_replace_me
IMAGEKIT_PRIVATE_KEY=private_replace_me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Maximum size of one issue photo in bytes (default 5 MB).
ISSUE_IMAGE_MAX_BYTES=5242880
# How many issues one citizen may report per minute (anti spam).
ISSUE_RATE_LIMIT_PER_MINUTE=60
# How many issue photos one citizen may upload per minute (anti spam).
ISSUE_UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Authority verification. Identity documents are uploaded to ImageKit as PRIVATE
# files (only the reference is stored in PostgreSQL) and are never exposed to the
# candidate, only to an admin reviewing the application.
# Maximum size of one government identity document in bytes (default 8 MB).
AUTHORITY_DOCUMENT_MAX_BYTES=8388608
# How many authority applications one account may submit/re-submit per minute.
AUTHORITY_APPLICATION_RATE_LIMIT_PER_MINUTE=10

# Frontend origin allowed by CORS (comma separated for several origins).
# Required for cookies: the browser only sends the access_token cookie when
# CORS is configured with an explicit origin and credentials: true.
FRONTEND_URL=http://localhost:5173,https://urban-shield-ai-iota.vercel.app
# AI - Watcher/Boss nodes (LangGraph + OpenRouter).
# OPENROUTER_API_KEY is optional at boot: without it every reported issue simply
# stays in REPORTED and the rest of the API keeps working (WATCHER_UNAVAILABLE).
# Server side only - never sent to the browser, never logged.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model used by the Watcher/Boss node (any OpenRouter model id).
OPENROUTER_MODEL=openai/gpt-4o-mini
# Hard cap in milliseconds for one Watcher run.
WATCHER_TIMEOUT_MS=60000
# Hard cap in milliseconds for one Boss run.
BOSS_TIMEOUT_MS=60000
# AI assistant (`POST /api/ai/chat`), backed by Mistral.
# MISTRAL_API_KEY is optional at boot: without it the assistant returns
# AI_SERVICE_UNAVAILABLE and the rest of the API keeps working.
# Server side only - never sent to the browser, never logged.
MISTRAL_API_KEY=your_mistral_api_key_here
# Mistral model id (must be available on your subscription tier).
MISTRAL_MODEL=open-mistral-nemo
# Mistral REST base url (OpenAI-compatible chat completions).
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Hard cap in milliseconds for one assistant model call.
AI_CHAT_TIMEOUT_MS=30000
# How many assistant requests one account may send per minute.
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
# Longest single assistant question accepted, in characters.
AI_CHAT_MESSAGE_MAX_LENGTH=1000
# How many prior conversation turns are sent back to the model.
AI_CHAT_HISTORY_MAX_TURNS=6
# How many civic records are summarised into the assistant context.
AI_CHAT_CONTEXT_LIMIT=20
# Weather for the assistant's 3-day civic forecast uses Open-Meteo (free, keyless).
# No weather API key is required.

