{
  "name": "climate-smart-city-backend",
  "version": "1.0.0",
  "description": "Climate Smart City - authentication backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/src/db/migrate.js",
    "test:api": "tsx scripts/test-auth-api.ts",
    "test:issues": "tsx scripts/test-issue-api.ts",
    "test:admin": "tsx scripts/test-admin-issue-api.ts",
    "test:authority": "tsx scripts/test-authority-api.ts",
    "test:authority-issues": "tsx scripts/test-authority-issue-api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.15",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
