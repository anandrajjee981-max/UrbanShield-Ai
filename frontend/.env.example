# Base URL of the backend API.
# Must match a value listed in the backend FRONTEND_URL / CORS allow list,
# otherwise the browser drops the access_token cookie.
# VITE_API_BASE_URL=http://localhost:4000

# Realtime endpoint. Falls back to VITE_API_BASE_URL when unset.
# VITE_WS_URL=ws://localhost:4000/ws

# Set to "false" to talk to the real backend.
# Anything else (or unset) runs the app against the deterministic mock dataset.
# VITE_USE_MOCK=false
