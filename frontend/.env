# Use the Vite development proxy so the browser calls the same origin.
VITE_API_URL=/api
# Local dev: Vite forwards /api to the backend. Backend runs on PORT=4000 (backend/.env).
# In Docker Compose this is overridden by VITE_API_PROXY_TARGET=http://backend:4000.
VITE_API_PROXY_TARGET=http://localhost:4000

